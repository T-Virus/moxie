      "fields": [
        {"k":"genre","l":"题材与基调","t":"str","p":"D:story_bible.genre","s":"existing","r":"必填","n":"现为四个题材词连写，建议拆结构"},
        {"k":"type_primary","l":"主类型","t":"str","p":"N:book.type_primary","s":"new","r":"必填","n":"玄幻 / 都市 / 悬疑 / 言情 / 科幻 / 末世等"},
        {"k":"type_secondary","l":"子类型","t":"str[]","p":"N:book.type_secondary","s":"new","r":"选填","n":"废土求生、学院竞技、基因异能"},
