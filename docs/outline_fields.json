        {"k":"estimated_words","l":"预估字数","t":"int","p":"N:book.estimated_words","s":"new","r":"必填","n":"模板明确要求；与 meta.word_count_actual 对应"},
        {"k":"length_class","l":"篇幅分类","t":"enum:短篇|中篇|长篇|超长篇","p":"N:book.length_class","s":"new","r":"选填","n":"由预估字数推导"},
        {"k":"total_chapters_planned","l":"计划章数","t":"int","p":"N:book.total_chapters_planned","s":"new","r":"选填","n":"与实际 n_chapters 对比看偏差"},
        {"k":"chapter_words_target","l":"单章目标字数","t":"int","p":"N:book.chapter_words_target","s":"new","r":"选填","n":"如 2500–3000"},
        {"k":"serialization_pace","l":"连载节奏","t":"str","p":"N:book.serialization_pace","s":"new","r":"选填","n":"日更字数、爆更节点、卷末高潮位置"},
        {"k":"update_frequency","l":"更新频率","t":"str","p":"N:book.update_frequency","s":"new","r":"选填","n":"日更 2 章 / 周更等"},
        {"k":"content_rating","l":"内容分级","t":"enum:全年龄|16+|18+","p":"N:book.content_rating","s":"new","r":"选填","n":"平台审核用"},
        {"k":"ending_type","l":"结局类型","t":"enum:HE|BE|开放式|系列未完","p":"N:book.ending_type","s":"new","r":"必填","n":"模板结局部分要求"},
        {"k":"series_plan","l":"系列化规划","t":"str","p":"N:book.series_plan","s":"new","r":"选填","n":"续作 / 外传 / 多部曲"},
        {"k":"comparative_titles","l":"对标作品","t":"str[]","p":"N:book.comparative_titles","s":"new","r":"选填","n":"用于卖点定位与编辑沟通"},
        {"k":"keywords","l":"投稿关键词","t":"str[]","p":"N:book.keywords","s":"new","r":"选填","n":"平台标签、检索词"},
        {"k":"opening.strategy","l":"开篇切入策略","t":"enum:受辱反击|高能开场|反差日常|悬念倒叙","p":"D:opening.strategy","s":"code","r":"必填","n":"decompose 与 adapt.meta 均已定义，旧数据未落盘"},
        {"k":"opening.first_image","l":"第一个画面","t":"str","p":"D:opening.first_image","s":"code","r":"必填","n":"第一章开篇第一眼看到谁、在哪、做什么"},
