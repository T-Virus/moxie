{
  "meta": {
    "title": "小说大纲最全字段总表",
    "version": "1.0",
    "date": "2026-11-05",
    "based_on": [
      "data/迷失蔚蓝/decomposed.json",
      "data/迷失蔚蓝/storymap.json",
      "data/迷失蔚蓝/chapters.json",
      "src/story_bible.py（SB_FIELDS / CARD_FIELDS / FACTION_FIELDS）",
      "src/entities.py（ITEM_FIELDS）",
      "src/decompose.py（SCHEMA_JSON / opening）",
      "src/storymap.py（AI_SCHEMA_NOTE / map）",
      "src/adapt.py（META_TMPL / book_title）"
    ],
    "target_codes": {
      "D": "decomposed.json",
      "S": "storymap.json",
      "C": "chapters.json",
      "N": "建议新增结构（尚无落盘位置）"
    },
    "status_codes": {
      "existing": "已有：现存作品数据里已落盘",
      "code": "代码已定义：生成链路已支持，但《迷失蔚蓝》旧产物里没有",
      "partial": "待补值：字段存在但当前数据为空或不完整",
      "new": "建议新增：模板要求、当前项目尚未定义"
    },
    "required_codes": {
      "必填": "缺失即视为大纲不完整",
      "选填": "按题材取用",
      "自动": "由程序计算或生成，不需人工填写"
    },
    "field_columns": ["k=字段 key", "l=中文名", "t=类型", "p=落盘位置", "s=状态", "r=必填性", "n=说明与取值"]
  },
  "groups": [
    {
      "id": "0",
      "title": "文档元数据与工程字段",
      "desc": "标识这份大纲是谁的、哪一版、从哪来。现有产物只有少量散落字段，建议统一到顶层 meta。",
      "fields": [
        {"k":"book_name","l":"作品名","t":"str","p":"目录名","s":"existing","r":"必填","n":"当前以目录名充当书名，无独立字段"},
        {"k":"book_title","l":"正式书名","t":"str","p":"N:meta.book_title","s":"code","r":"必填","n":"adapt.meta 会生成 2~8 字新书名，拆解链路未写入"},
        {"k":"title_alternatives","l":"备选书名","t":"str[]","p":"N:meta.title_alternatives","s":"new","r":"选填","n":"3~5 个备选，投稿时替换"},
        {"k":"book_summary","l":"全书梗概","t":"str","p":"D:book_summary","s":"existing","r":"必填","n":"300~500 字剧情梗概"},
        {"k":"author","l":"作者","t":"str","p":"C:author","s":"existing","r":"必填","n":"原著作者或笔名"},
        {"k":"status","l":"作品状态","t":"enum:连载中|已完结|改编中|弃坑","p":"C:status","s":"existing","r":"必填","n":"当前仅字符串「已完结」"},
        {"k":"generated_at","l":"生成时间","t":"datetime","p":"S:generated_at","s":"existing","r":"自动","n":"storymap 生成时间"},
        {"k":"ai","l":"是否 AI 生成","t":"bool","p":"S:ai","s":"existing","r":"自动","n":"图谱是否由模型产出"},
        {"k":"n_chapters","l":"章节总数","t":"int","p":"S:n_chapters","s":"existing","r":"自动","n":"当前 395"},
        {"k":"era","l":"时代背景","t":"str","p":"S:era","s":"existing","r":"选填","n":"含时间跨度的一句话"},
        {"k":"schema_version","l":"数据结构版本","t":"str","p":"N:meta.schema_version","s":"new","r":"必填","n":"如 2.0；字段扩展后旧数据可平滑迁移"},
        {"k":"outline_version","l":"大纲版本","t":"str","p":"N:meta.outline_version","s":"new","r":"必填","n":"人工修订版本号，如 v3.2"},
        {"k":"source_type","l":"来源类型","t":"enum:原创|原著拆解|改编|续写","p":"N:meta.source_type","s":"new","r":"必填","n":"决定是否需要版权确认"},
        {"k":"source_file","l":"来源文件","t":"str","p":"N:meta.source_file","s":"new","r":"选填","n":"input/ 下的原始文本相对路径"},
        {"k":"source_rights_ack","l":"权利确认","t":"obj","p":"N:meta.source_rights_ack","s":"new","r":"选填","n":"version / accepted_at / account；云端任务已要求 compliance_ack"},
        {"k":"created_at","l":"创建时间","t":"datetime","p":"N:meta.created_at","s":"new","r":"自动","n":"大纲首次建立时间"},
        {"k":"updated_at","l":"最后修改","t":"datetime","p":"N:meta.updated_at","s":"new","r":"自动","n":"任一字段变更时刷新"},
        {"k":"generator_model","l":"生成模型","t":"str","p":"N:meta.generator_model","s":"new","r":"自动","n":"如 deepseek-v4-flash，便于复现与成本归因"},
        {"k":"generator_prompt_version","l":"提示词版本","t":"str","p":"N:meta.generator_prompt_version","s":"new","r":"自动","n":"对应 prompts 覆盖版本，便于追溯质量波动"},
        {"k":"word_count_actual","l":"实际字数","t":"int","p":"N:meta.word_count_actual","s":"new","r":"自动","n":"统计 manuscript 或原著正文"},
        {"k":"word_count_planned","l":"预估字数","t":"int","p":"N:book.estimated_words","s":"new","r":"必填","n":"模板基础信息要求；长篇/中篇/短篇"},
        {"k":"language","l":"语言与地区","t":"str","p":"N:meta.language","s":"new","r":"选填","n":"简体中文 / 繁体 / 英文"},
        {"k":"tags","l":"全局标签","t":"str[]","p":"N:meta.tags","s":"new","r":"选填","n":"跨模块检索标签"},
        {"k":"revision_note","l":"修订说明","t":"str","p":"N:meta.revision_note","s":"new","r":"选填","n":"本版改了什么、为什么改"},
        {"k":"rights_status","l":"版权与合规状态","t":"enum:自有|已授权|待确认|不可商用","p":"N:meta.rights_status","s":"new","r":"必填","n":"与商业计划书的合规闸门对齐"}
      ]
    },
    {
      "id": "1",
      "title": "基础信息（作品定位标签）",
