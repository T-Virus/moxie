        {"k":"target_platform","l":"目标平台","t":"str[]","p":"N:book.target_platform","s":"new","r":"必填","n":"起点 / 番茄 / 晋江 / 短剧 / 实体出版"},
        {"k":"platform_style","l":"平台风格参数","t":"obj","p":"N:book.platform_style","s":"new","r":"选填","n":"单章字数、章末钩子密度、爽点间隔、断章位置"},
        {"k":"target_reader_age","l":"读者年龄段","t":"str","p":"N:book.target_reader_age","s":"new","r":"选填","n":"如 18–30"},
