ENV=production
APP_NAME=moxie-server
API_PREFIX=/v1

# 管理端跨域：逗号分隔的精确来源（禁止 *，生产启动会校验）
CORS_ALLOW_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Idempotency-Key,X-Request-Id,X-Rights-Confirmed,X-BYOK-Key,X-Payload-Key,X-Payload-Client,X-Payload-Nonce,X-Payload-Encrypted
CORS_MAX_AGE_SECONDS=600

# Postgres（docker-compose 内的服务名）
# 生产启动校验：不可沿用默认 SQLite，也不可包含 change-me 占位口令
DATABASE_URL=postgresql+psycopg://moxie:change-me-in-production@postgres:5432/moxie
AUTO_CREATE_TABLES=false

# Redis（队列 + 限流 + 预占快速检查）
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# JWT：生产环境必须换成长随机串（>= 32 字符，且不能包含 change-me 占位）
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# 应用层载荷加密：ECDH(P-256) + AES-256-GCM
# 生产必须显式配置 EC P-256 私钥；缺失时应用启动失败
# 生成：openssl ecparam -name prime256v1 -genkey -noout -out payload_private.pem
# 多行 PEM 在 .env 里用双引号包裹并把换行写成 \n
PAYLOAD_CRYPTO_PRIVATE_KEY_PEM=
# 关闭后所有 JSON/SSE 接口退回明文（仅本地调试或灰度回滚使用）
PAYLOAD_ENCRYPTION_ENABLED=true
# 强制 JSON 请求必须为密文；过渡期可设为 false 兼容旧客户端
PAYLOAD_ENCRYPTION_REQUIRED=true

# 设备与 License
MAX_DEVICES=2
LICENSE_KEY_ID=moxie-license-1
# 生产必填：Ed25519 私钥；缺失时应用启动失败（多 worker 禁止临时密钥）
# 生成：openssl genpkey -algorithm ed25519 -out license_private.pem
# 或：python -c "from app.security import LicenseSigner; print(LicenseSigner.generate_pem())"
# 多行 PEM 在 .env 里用双引号包裹并把换行写成 \n
LICENSE_PRIVATE_KEY_PEM=
# 仅单进程本地开发可设为 true 允许临时密钥；生产必须 false
LICENSE_ALLOW_EPHEMERAL_KEY=false
LICENSE_REFRESH_DAYS=7
LICENSE_GRACE_DAYS=14

# 支付
# mock/fake 仅 ENV=test/dev 可用；生产保持 false，否则启动失败
PAYMENTS_MOCK_ENABLED=false
PAYMENTS_FAKE_ENABLED=false
# mock/fake 回调签名密钥；启用 mock/fake 时必填
MOCK_PAYMENT_SECRET=
SUBSCRIPTION_REMINDER_DAYS=7
SUBSCRIPTION_GRACE_DAYS=3
PAYMENT_TIMEOUT_SECONDS=20
WEBHOOK_TOLERANCE_SECONDS=300
# 回调来源 IP 白名单（逗号分隔）；留空只依赖渠道签名
PAYMENT_WEBHOOK_IP_ALLOWLIST=
# 日对账覆盖渠道（逗号分隔；未配置凭据的会自动跳过）
PAYMENT_RECONCILE_PROVIDERS=wechat,alipay,stripe

# 微信支付 v3（金额单位：分）
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PRIVATE_KEY_PEM=
WECHAT_CERT_SERIAL_NO=
WECHAT_PLATFORM_CERT_PATH=
WECHAT_PLATFORM_CERT_PEM=
WECHAT_PLATFORM_SERIAL_NO=
WECHAT_NOTIFY_URL=https://your-domain.com/v1/webhooks/wechat
WECHAT_PAY_SCENE=native

# 支付宝（金额单位：元；RSA2）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PRIVATE_KEY_PEM=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/v1/webhooks/alipay
ALIPAY_RETURN_URL=https://your-domain.com/v1/payments/alipay/return
ALIPAY_SCENE=page

# Stripe（测试模式用 sk_test_… / whsec_…）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-domain.com/v1/payments/stripe/success
STRIPE_CANCEL_URL=https://your-domain.com/v1/payments/stripe/cancel
STRIPE_PORTAL_RETURN_URL=https://your-domain.com/account
STRIPE_API_BASE=https://api.stripe.com

# 公开榜单抓取（热门写作调研）：只取书名/作者/排名等元数据，不抓正文
RANKING_ENABLED=true
RANKING_SOURCES=qidian,fanqie,zongheng,jinjiang
RANKING_FEMALE_SOURCES=xxsy,hongxiu,jinjiang
RANKING_TIMEOUT_SECONDS=6
RANKING_CACHE_SECONDS=21600

# 模型网关（拆解链路只走本服务网关，不直连外部）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=change-me
LLM_MODEL=deepseek-v4-flash
GATEWAY_TIMEOUT_SECONDS=120
GATEWAY_MAX_RETRIES=2
GATEWAY_RATE_LIMIT_PER_MINUTE=60
MODEL_PRICE_CENTS_PER_1K_TOKENS=0.8
# 无真实 key 时用确定性假模型（不访问外网，仅测试/演示）
MODEL_STUB=false

# 拆解链路
# src/ 代码根目录：提示词与 schema 从桌面端 src 复用（只读挂载）
SRC_PATH=/src
# 每处理 N 段主动让出 worker（0=不限）；设为 1 可在本地观察断点续跑
DECOMPOSE_SEGMENT_BATCH=0
# 允许读取的源文件根目录（逗号分隔；生产只挂载受控目录）
TASK_SOURCE_DIRS=/data/input
TASK_MAX_SOURCE_BYTES=5242880

# 客户端上传源文件（POST /v1/uploads）
UPLOAD_MAX_BYTES=31457280
UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.markdown,.csv,.json
UPLOAD_RATE_LIMIT_PER_MINUTE=10
# 上传源文件保留天数；0 = 不自动清理（只能显式 DELETE）
UPLOAD_RETENTION_DAYS=30

# 产物存储：db（默认，产物与上传源文件全部写入数据库）/ local（磁盘 fallback）/
# s3（MinIO / OSS / S3；需 requirements.txt 中的 boto3）
# STORAGE_BACKEND=db 时 api/worker/scheduler 必须连同一个数据库
STORAGE_BACKEND=db
STORAGE_LOCAL_DIR=/var/lib/moxie/artifacts
# 本地签名下载对外地址；留空返回相对路径
STORAGE_PUBLIC_BASE_URL=
ARTIFACT_PRESIGN_SECONDS=900
# 本地签名密钥；留空则复用 JWT_SECRET
ARTIFACT_SIGNING_SECRET=
S3_ENDPOINT_URL=http://minio:9000
# 容器内访问用 S3_ENDPOINT_URL；浏览器下载预签名链接需要这个公开地址
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=moxie
# STORAGE_BACKEND=s3 时生产启动校验：不可使用 minioadmin / change-me 示例凭据
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-secret
S3_REGION=us-east-1
S3_SECURE=false

LOG_LEVEL=INFO

# 可观测
METRICS_ENABLED=true
# 留空则完全静默；配置后自动上报异常
SENTRY_DSN=

# 定时 / 自愈（独立进程：python -m app.scheduler）
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
# running 任务的租约（秒）；超时由 scheduler 重新入队
TASK_LEASE_SECONDS=1800

# 防滥用（按 IP / 分钟，Redis 计数）
REGISTER_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_MINUTE=20
# 日用量超过「月额度/30 × 倍数」只写审计告警，不封禁
USAGE_ALERT_MULTIPLIER=3.0

# 额度包（一次性购买；套餐优先扣减，不足再扣包）
CREDIT_PACK_VALIDITY_DAYS=365
REFUND_PRORATION_ENABLED=true

# 通知：站内信默认开，邮件/短信默认关（短信当前为 noop 适配位）
NOTIFICATIONS_ENABLED=true
NOTIFICATION_INAPP_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=300
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
SMS_PROVIDER=noop
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# 相似度/改编幅度检查（纯本地 n-gram）
SIMILARITY_NGRAM=8
SIMILARITY_THRESHOLD=0.35
SIMILARITY_MAX_PARAGRAPHS=20

# 离线安装包目录：GET /v1/downloads/windows|android（需登录），按扩展名取最新构建产物
OFFLINE_WINDOWS_DIR=/app/dist
OFFLINE_ANDROID_DIR=/app/mobile/dist

# AI 封面：OpenAI 兼容 /images/generations；留空则跳过模型，直接走 Pollinations
IMAGE_API_BASE=
IMAGE_API_KEY=
IMAGE_MODEL=
# 免费出图兜底（Pollinations）；关闭后只走模型或本地绘制
COVER_POLLINATIONS_ENABLED=true
COVER_WIDTH=1400
COVER_HEIGHT=2100
COVER_TIMEOUT_SECONDS=180
# 用户上传封面的大小上限（字节），默认 10MB
COVER_UPLOAD_MAX_BYTES=10485760

# 合规闸门：拆解/改编任务必须显式确认参考作品使用权与 AIGC 标注
LEGAL_GATE_ENABLED=true

# 电子发票渠道：stub（本地模拟，默认）/ nuonuo（真实适配位）
# 真实渠道缺少 INVOICE_APP_KEY / INVOICE_APP_SECRET 时接口返回 501 invoice_provider_not_configured
INVOICE_PROVIDER=stub
INVOICE_CALLBACK_SECRET=
INVOICE_STUB_URL=
INVOICE_API_BASE=https://open.nuonuo.com
INVOICE_APP_KEY=
INVOICE_APP_SECRET=
INVOICE_SELLER_TAX_NO=

# MinIO 容器凭据（与上面的 S3_ACCESS_KEY / S3_SECRET_KEY 保持一致）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-secret
