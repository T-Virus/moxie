ENV=production
APP_NAME=moxie-server
API_PREFIX=/v1
# 是否暴露 /docs /redoc /openapi.json；留空时仅非生产环境开启，生产默认关闭
DOCS_ENABLED=

# 管理端跨域：逗号分隔的精确来源（禁止 *，生产启动会校验）
CORS_ALLOW_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Idempotency-Key,X-Request-Id,X-Rights-Confirmed,X-BYOK-Key,X-Payload-Key,X-Payload-Client,X-Payload-Nonce,X-Payload-Encrypted,X-Trace-Id,Traceparent
CORS_MAX_AGE_SECONDS=600

# 反代与请求体边界：
# 生产部署在 nginx/网关后时必须设 true，nginx 必须用 $remote_addr 覆盖 X-Forwarded-For；
# 直连部署保持 false，避免客户端伪造 XFF 绕过限流/登录锁定。
TRUST_PROXY=true
# 请求体上限（字节）；全局中间件与载荷解密层共用，旧名 MOXIE_MAX_BODY_BYTES 仍兼容。
MAX_REQUEST_BODY_BYTES=4194304

# 首名管理员 bootstrap（可选，留空时不处理）：
# 用下面的邮箱注册账号后，服务启动会幂等地把它提升为管理员；
# 也可对已注册账号执行 `python scripts/bootstrap_admin.py --email 18021524721@163.com`。
BOOTSTRAP_ADMIN_EMAILS=18021524721@163.com

# 用户数据权利：
# /v1/me/export 导出个人数据；/v1/me/delete 提交注销申请（需密码 + 显式确认串）。
# 宽限期内账号停止登录，到期由 scheduler 清除账号、上传源文件和产物。
ACCOUNT_DELETION_GRACE_DAYS=7
# 导出时单个对象超过该字节数只给元数据/临时下载链接；最多内联对象数。
ACCOUNT_EXPORT_OBJECT_MAX_BYTES=2097152
ACCOUNT_EXPORT_MAX_OBJECTS=200

# Postgres（docker-compose 内的服务名）
# 生产启动校验：不可沿用默认 SQLite，也不可包含 change-me 占位口令
DATABASE_URL=postgresql+psycopg://moxie:change-me-in-production@postgres:5432/moxie
AUTO_CREATE_TABLES=false

# Redis（队列 + 限流 + 预占快速检查）
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
# RQ worker 副本数；每个副本同一时刻消费一个任务，按套餐最大并发 4 配置
# start.sh / start_online.bat 启动时会用这个值执行 --scale worker=N
WORKER_REPLICAS=4

# JWT：生产环境必须换成长随机串（>= 32 字符，且不能包含 change-me 占位）
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# 应用层载荷加密：ECDH(P-256) + AES-256-GCM
# 生产必须显式配置 EC P-256 私钥；缺失时应用启动失败
# 生成：openssl ecparam -name prime256v1 -genkey -noout -out payload_private.pem
# 多行 PEM 在 .env 里用双引号包裹并把换行写成 \n
PAYLOAD_CRYPTO_PRIVATE_KEY_PEM=
# 关闭后所有 JSON/SSE 接口退回明文（仅本地调试或灰度回滚使用）
PAYLOAD_ENCRYPTION_ENABLED=true
# 强制 JSON 请求必须为密文；过渡期可设为 false 兼容旧客户端
PAYLOAD_ENCRYPTION_REQUIRED=true

# 设备与 License
MAX_DEVICES=2
LICENSE_KEY_ID=moxie-license-1
# 生产必填：Ed25519 私钥；缺失时应用启动失败（多 worker 禁止临时密钥）
# 生成：openssl genpkey -algorithm ed25519 -out license_private.pem
# 或：python -c "from app.security import LicenseSigner; print(LicenseSigner.generate_pem())"
# 多行 PEM 在 .env 里用双引号包裹并把换行写成 \n
LICENSE_PRIVATE_KEY_PEM=
# 仅单进程本地开发可设为 true 允许临时密钥；生产必须 false
LICENSE_ALLOW_EPHEMERAL_KEY=false
LICENSE_REFRESH_DAYS=7
LICENSE_GRACE_DAYS=14

# 支付
# mock/fake 仅 ENV=test/dev 可用；生产保持 false，否则启动失败
PAYMENTS_MOCK_ENABLED=false
PAYMENTS_FAKE_ENABLED=false
# mock/fake 回调签名密钥；启用 mock/fake 时必填
MOCK_PAYMENT_SECRET=
SUBSCRIPTION_REMINDER_DAYS=7
SUBSCRIPTION_GRACE_DAYS=3
PAYMENT_TIMEOUT_SECONDS=20
WEBHOOK_TOLERANCE_SECONDS=300
# 回调来源 IP 白名单（逗号分隔）；留空只依赖渠道签名
PAYMENT_WEBHOOK_IP_ALLOWLIST=
# 日对账覆盖渠道（逗号分隔；未配置凭据的会自动跳过）
PAYMENT_RECONCILE_PROVIDERS=wechat,alipay,stripe

# 微信支付 v3（金额单位：分）
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PRIVATE_KEY_PEM=
WECHAT_CERT_SERIAL_NO=
WECHAT_PLATFORM_CERT_PATH=
WECHAT_PLATFORM_CERT_PEM=
WECHAT_PLATFORM_SERIAL_NO=
WECHAT_NOTIFY_URL=https://your-domain.com/v1/webhooks/wechat
WECHAT_PAY_SCENE=native

# 支付宝（金额单位：元；RSA2）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PRIVATE_KEY_PEM=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/v1/webhooks/alipay
ALIPAY_RETURN_URL=https://your-domain.com/v1/payments/alipay/return
ALIPAY_SCENE=page

# Stripe（测试模式用 sk_test_… / whsec_…）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-domain.com/v1/payments/stripe/success
STRIPE_CANCEL_URL=https://your-domain.com/v1/payments/stripe/cancel
STRIPE_PORTAL_RETURN_URL=https://your-domain.com/account
STRIPE_API_BASE=https://api.stripe.com

# 统一技能目录：10 环节技能清单位置；留空则按部署布局自动探测 config/skills_catalog.json
# SKILLS_CATALOG_PATH=/path/to/config/skills_catalog.json

# 公开榜单抓取（热门写作调研）：只取书名/作者/排名等元数据，不抓正文
RANKING_ENABLED=true
RANKING_SOURCES=qidian,fanqie,zongheng,jinjiang
RANKING_FEMALE_SOURCES=xxsy,hongxiu,jinjiang
RANKING_TIMEOUT_SECONDS=6
RANKING_CACHE_SECONDS=21600

# 模型网关（拆解链路只走本服务网关，不直连外部）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=change-me
LLM_MODEL=deepseek-v4-flash
# 后台「模型配置」提交自定义网关地址时的 SSRF 防护：
# 默认禁止内网 / 回环 / 云元数据地址；自托管 Ollama 等确需内网时再设为 true。
MODEL_GATEWAY_ALLOW_PRIVATE_NETWORKS=false
GATEWAY_TIMEOUT_SECONDS=120
GATEWAY_MAX_RETRIES=2
GATEWAY_RATE_LIMIT_PER_MINUTE=60
MODEL_PRICE_CENTS_PER_1K_TOKENS=0.8
# 无真实 key 时用确定性假模型（不访问外网，仅测试/演示）
MODEL_STUB=false

# Agent 全书大纲默认章数：留空时按 ENV 自动选择
#   生产（ENV=prod/production/...）：长篇 2000 / 短篇 200 / 每批 20 章
#   开发测试（ENV=dev/test/local）：长篇 30 / 短篇 10 / 每批 10 章
# 下面各项只在需要覆盖自动值时才取消注释，不要留空值。
# OUTLINE_LONG_CHAPTERS=30
# OUTLINE_SHORT_CHAPTERS=10
# 单本硬上限（显式 target_chapters 也受此限制，最大 5000）
# OUTLINE_MAX_CHAPTERS=5000
# 每批生成多少章章纲；越小越不易截断，但调用次数越多
# OUTLINE_CHAPTER_BATCH=10

# 拆解链路
# src/ 代码根目录：提示词与 schema 从桌面端 src 复用（只读挂载）
SRC_PATH=/src
# 每处理 N 段主动让出 worker（0=不限）；设为 1 可在本地观察断点续跑
DECOMPOSE_SEGMENT_BATCH=0
# 允许读取的源文件根目录（逗号分隔；生产只挂载受控目录）
TASK_SOURCE_DIRS=/data/input
TASK_MAX_SOURCE_BYTES=5242880

# 客户端上传源文件（POST /v1/uploads）
UPLOAD_MAX_BYTES=31457280
UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.markdown,.csv,.json
UPLOAD_RATE_LIMIT_PER_MINUTE=10
# 上传源文件保留天数；0 = 不自动清理（只能显式 DELETE）
UPLOAD_RETENTION_DAYS=30

# 产物存储：db（默认，产物与上传源文件全部写入数据库）/ local（磁盘 fallback）/
# s3（MinIO / OSS / S3；需 requirements.txt 中的 boto3）
# STORAGE_BACKEND=db 时 api/worker/scheduler 必须连同一个数据库
STORAGE_BACKEND=db
STORAGE_LOCAL_DIR=/var/lib/moxie/artifacts
# 本地签名下载对外地址；留空返回相对路径
STORAGE_PUBLIC_BASE_URL=
ARTIFACT_PRESIGN_SECONDS=900
# 产物下载签名密钥（>=32 字符）。生产必须显式配置，不可复用 JWT_SECRET。
# 可用 `./preflight.sh --gen-secrets` 自动生成。
ARTIFACT_SIGNING_SECRET=
# 工序模型 Key 的加密口令（>=32 字符）。生产必须显式配置，否则模型 Key 无法安全落库。
# 可用 `./preflight.sh --gen-secrets` 自动生成；更换后需重新录入后台模型 Key。
MODEL_KEY_SECRET=
S3_ENDPOINT_URL=http://minio:9000
# 容器内访问用 S3_ENDPOINT_URL；浏览器下载预签名链接需要这个公开地址
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=moxie
# STORAGE_BACKEND=s3 时生产启动校验：不可使用 minioadmin / change-me 示例凭据
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-secret
S3_REGION=us-east-1
S3_SECURE=false

LOG_LEVEL=INFO

# 可观测
METRICS_ENABLED=true
# /metrics 访问令牌：配置后需带 X-Metrics-Token 头（或 ?token=）抓取；
# 生产未配置时 /metrics 返回 403，避免队列与业务指标公开暴露。
METRICS_TOKEN=
# 留空则完全静默；配置后自动上报异常
SENTRY_DSN=
# 前端错误上报采样/去重的环境变量默认值（后台 /v1/admin/telemetry-config 可热改覆盖）
CLIENT_ERROR_SENTRY_SAMPLE_RATE=1.0
CLIENT_ERROR_SENTRY_DEDUPE_WINDOW_SECONDS=60
CLIENT_ERROR_SENTRY_DEDUPE_MAX_ENTRIES=64
# 灰度发布（canary_percent + canary 覆盖项）在后台 /v1/admin/telemetry-config 配置，
# 按错误指纹 sha256 稳定分桶，无对应环境变量；灰度比例 0 = 全量走基线值。

# 云端正文分段调度：默认黄金三章；全本可用 options.body_start/body_chapters/body_segment
# 分段写，章号稳定、跨段记忆继承。max 为单次 run 的硬上限，防超额占额度。
AGENT_CLOUD_BODY_CHAPTERS=3
AGENT_CLOUD_BODY_MAX_CHAPTERS=2000

# 定时 / 自愈（独立进程：python -m app.scheduler）
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
# running 任务的租约（秒）；超时由 scheduler 重新入队
TASK_LEASE_SECONDS=1800

# 数据库备份（admin「备份管理」可手动备份/下载/恢复；定时由独立 scheduler 容器执行）
BACKUP_ENABLED=true
# 开启定时备份：scheduler 每 SCHEDULER_INTERVAL_SECONDS 检查一次，距上次备份超过
# BACKUP_INTERVAL_MINUTES 才创建新的 scheduled 备份；需独立 scheduler 容器常驻运行
# （docker compose up -d scheduler）。改代码/装 pg 客户端后必须 --build scheduler。
BACKUP_SCHEDULE_ENABLED=false
BACKUP_INTERVAL_MINUTES=720
# 留空时容器内用 /app/backups、本地直跑用 server/backups。
# compose 已把名为 backupdata 的卷挂到 /app/backups（api 与 scheduler 共用），容器重建不丢备份。
# 生产可指向独立磁盘挂载点，勿与数据库同盘。
BACKUP_DIR=
BACKUP_RETENTION_COUNT=14
# 多个收件人用英文逗号分隔；复用下方 SMTP_* 配置；留空则只落盘不发邮件
BACKUP_EMAIL_ENABLED=true
BACKUP_NOTIFY_EMAILS=

# 防滥用（按 IP / 分钟，Redis 计数）
REGISTER_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_MINUTE=20
# 租户级限流（按 account_id / 分钟）；模型网关、上传、任务创建共用。
# 0 = 关闭；开启后与各自接口限流并行，任一超限即 429。
TENANT_RATE_LIMIT_PER_MINUTE=0
# 日用量超过「月额度/30 × 倍数」只写审计告警，不封禁
USAGE_ALERT_MULTIPLIER=3.0

# 额度包（一次性购买；套餐优先扣减，不足再扣包）
CREDIT_PACK_VALIDITY_DAYS=365
REFUND_PRORATION_ENABLED=true

# 通知：站内信默认开，邮件/短信默认关（短信当前为 noop 适配位）
# 注意：NOTIFICATION_EMAIL_ENABLED 仅控制普通业务邮件（续费/账单等）；
# 注册验证邮件会强制走 SMTP，不受此开关影响，只要下面 SMTP_* 已配置即可发出。
NOTIFICATIONS_ENABLED=true
NOTIFICATION_INAPP_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=300
# 推送服务返回 429 时 Retry-After 建议退避的上限（秒），防畸形 header 卡死投递
NOTIFICATION_PUSH_RETRY_AFTER_CAP_SECONDS=3600
# 邮件传输：smtp（真实发送）/ fake（仅写发送记录，不连外网，适合本地调试）
NOTIFICATION_EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
SMS_PROVIDER=noop
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
# Web Push：私钥/server 侧开关缺失时只写 skipped，不影响主流程。
# VAPID 密钥对可用 `pyvapidgen` 或 `openssl ecparam` 生成；公钥配到前端 VITE_VAPID_PUBLIC_KEY。
NOTIFICATION_PUSH_ENABLED=false
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 相似度/改编幅度检查（纯本地 n-gram）
SIMILARITY_NGRAM=8
SIMILARITY_THRESHOLD=0.35
SIMILARITY_MAX_PARAGRAPHS=20

# 离线安装包目录：GET /v1/downloads/windows|android（需登录），按扩展名取最新构建产物
OFFLINE_WINDOWS_DIR=/app/dist
OFFLINE_ANDROID_DIR=/app/mobile/dist

# AI 封面：OpenAI 兼容 /images/generations；留空则跳过模型，直接走 Pollinations
IMAGE_API_BASE=
IMAGE_API_KEY=
IMAGE_MODEL=
# 免费出图兜底（Pollinations）；关闭后只走模型或本地绘制
COVER_POLLINATIONS_ENABLED=true
COVER_WIDTH=1400
COVER_HEIGHT=2100
COVER_TIMEOUT_SECONDS=180
# 用户上传封面的大小上限（字节），默认 10MB
COVER_UPLOAD_MAX_BYTES=10485760
# Agent 三模式流程完成后是否自动生成封面图；关闭后可在作品信息页手动生成
AGENT_COVER_AUTO_GENERATE=true

# 合规闸门：拆解/改编任务必须显式确认参考作品使用权与 AIGC 标注
LEGAL_GATE_ENABLED=true

# 邮箱验证：注册后必须验证邮箱才能登录（true=强制；测试/演示可临时关闭）
EMAIL_VERIFICATION_REQUIRED=true
# 验证邮件链接有效期（分钟）
EMAIL_VERIFY_TOKEN_TTL_MINUTES=1440
# 验证邮件里的链接前缀（用户端站点地址）；留空则自动用请求的 Origin 头拼接
APP_CLIENT_BASE_URL=
# 管理端重置密码邮件链接前缀：管理员忘记密码走此地址，须含 /admin 前缀。
# 管理端为 hash 路由，最终链接形如 https://your-domain.com/admin/#/reset-password?token=...
# 必须与 APP_CLIENT_BASE_URL 区分，避免管理员收到用户端链接；留空回退 Origin。
APP_ADMIN_BASE_URL=
# 同一账号两次验证邮件的最小发送间隔（秒）：防止重发接口被无限盗刷 / 邮件轰炸
EMAIL_RESEND_COOLDOWN_SECONDS=60

# 电子发票渠道：stub（本地模拟，默认）/ nuonuo（真实适配位）
# 真实渠道缺少 INVOICE_APP_KEY / INVOICE_APP_SECRET 时接口返回 501 invoice_provider_not_configured
INVOICE_PROVIDER=stub
INVOICE_CALLBACK_SECRET=
INVOICE_STUB_URL=
INVOICE_API_BASE=https://open.nuonuo.com
INVOICE_APP_KEY=
INVOICE_APP_SECRET=
INVOICE_SELLER_TAX_NO=

# MinIO 容器凭据（与上面的 S3_ACCESS_KEY / S3_SECRET_KEY 保持一致）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-secret
