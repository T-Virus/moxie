<?xml version="1.0" encoding="utf-8"?>
<!-- 后端跑在电脑局域网内，走的是明文 HTTP：只对本应用放开 cleartext，不修改系统全局设置 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
