# 在线服务端接口前缀；开发期留空走 Vite 代理 /v1，生产可填 https://api.example.com/v1
VITE_API_BASE=/v1

# 开发代理目标（Vite dev server 把 /v1 转发到这里），避免改服务端 CORS 白名单
VITE_API_PROXY=http://127.0.0.1:8000

# 上传文件大小上限（MB），仅前端预校验
VITE_MAX_UPLOAD_MB=20

# 站点正式域名（无尾斜杠）：构建时把 OG/Twitter 的分享 URL 与图片补成绝对地址。
# 留空则保持相对路径，便于本地/内网部署。
VITE_SITE_URL=https://moxie.example.com

# Web Push 的 VAPID 公钥（base64url）；留空则前端不展示通知开关。
# 发送端需服务端配置对应私钥，并在订阅后保存 endpoint。
VITE_VAPID_PUBLIC_KEY=
